  "keigo": {
    "_comment": "二重敬語・敬語の誤り",
    "rules": [
      {
        "find": "お伺いさせていただ",
        "to": "伺い",
        "severity": "warn",
        "note": "二重敬語"
      },
      {
        "find": "ご覧になられ",
        "to": "ご覧になり",
        "severity": "warn",
        "note": "二重敬語"
      },
      {
        "find": "おっしゃられ",
        "to": "おっしゃい",
        "severity": "warn",
        "note": "二重敬語"
      },
      {
        "find": "拝見させていただ",
        "to": "拝見し",
        "severity": "warn",
        "note": "二重敬語"
      },
      {
        "find": "お見えになられ",
        "to": "お見えになり",
        "severity": "warn",
        "note": "二重敬語"
      },
      {
        "find": "ご説明させていただ",
        "to": "説明し",
        "severity": "info",
        "note": "冗長な敬語"
      },
      {
        "find": "とんでもございません",
        "to": "とんでもないことです",
        "severity": "info"
      }
    ]
  },
  "symbols": {
    "_comment": "記号・機種依存文字",
    "rules": [
      {
        "find": "①",
        "to": "(1)",
        "severity": "warn",
        "note": "丸数字は機種依存文字。印刷所によって化ける"
      },
      {
        "find": "②",
        "to": "(2)",
        "severity": "warn",
        "note": "機種依存文字"
      },
      {
        "find": "③",
        "to": "(3)",
        "severity": "warn",
        "note": "機種依存文字"
      },
      {
        "find": "④",
        "to": "(4)",
        "severity": "warn",
        "note": "機種依存文字"
      },
      {
        "find": "⑤",
        "to": "(5)",
        "severity": "warn",
        "note": "機種依存文字"
      },
      {
        "find": "㈱",
        "to": "（株）",
        "severity": "warn",
        "note": "機種依存文字"
      },
      {
        "find": "㈲",
