      },
      {
        "find": "№",
        "to": "No.",
        "severity": "warn",
        "note": "機種依存文字"
      },
      {
        "find": "㍻",
        "to": "平成",
        "severity": "warn",
        "note": "機種依存文字"
      },
      {
        "find": "㎡",
