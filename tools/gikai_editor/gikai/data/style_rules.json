{
  "_comment": "議会だよりの表記ルール。第203号の Word 原稿と印刷版の差分から確認した実際のハウスルールを含む。severity: error / warn / info",
  "house": {
    "_comment": "この広報誌で実際に行われている書き換え（原稿→印刷版で確認済み）",
    "rules": [
      {
        "find": "等",
        "to": "など",
        "severity": "warn",
        "note": "本誌は「等」を「など」に開く",
        "context_exclude": [
          "等分",
          "等級",
          "平等",
          "均等",
          "同等",
          "上等",
          "対等",
          "等身",
          "高等",
          "初等",
          "中等",
          "等閑",
          "等式",
          "不等",
          "劣等",
          "優等",
          "一等",
          "二等",
          "三等"
        ]
      },
      {
        "find": "ひとつ",
        "to": "一つ",
        "severity": "warn",
        "note": "本誌は漢数字表記"
      },
      {
        "find": "買入れ",
        "to": "買い入れ",
        "severity": "warn",
        "note": "送り仮名を付ける"
      },
      {
        "find": "にて",
        "to": "で",
        "severity": "warn",
        "note": "「にて」は「で」に"
      },
      {
        "find": "子供",
        "to": "子ども",
        "severity": "warn",
        "note": "本誌は「子ども」"
      },
      {
        "find": "様々",
        "to": "さまざま",
        "severity": "warn",
        "note": "本誌は仮名書き"
      }
    ]
  },
  "kana": {
    "_comment": "公用文で仮名書きにするのが通例の語",
    "rules": [
      {
        "find": "出来る",
        "to": "できる",
        "severity": "warn"
      },
      {
        "find": "出来ない",
        "to": "できない",
        "severity": "warn"
      },
      {
        "find": "有る",
        "to": "ある",
        "severity": "info"
      },
      {
        "find": "無い",
        "to": "ない",
        "severity": "info"
      },
      {
        "find": "下さい",
        "to": "ください",
        "severity": "warn"
      },
      {
        "find": "頂く",
