        "severity": "info"
      },
      {
        "find": "殆ど",
        "to": "ほとんど",
        "severity": "warn"
      },
      {
        "find": "迄",
        "to": "まで",
        "severity": "warn"
      },
      {
        "find": "但し",
        "to": "ただし",
        "severity": "warn"
      },
