<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 以前向け。このアプリのデータを一切バックアップしない。
  秘密鍵と会話の履歴が Google のクラウドへ複製されるのを防ぐため。
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
