<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 以降向け。クラウドへのバックアップも、端末間のデータ移行も対象外にする。
  秘密鍵と会話の履歴を端末の中だけに留めるため。
  機種変更のときは、アプリの「JSONで保存」で自分の手で持ち運ぶ。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
