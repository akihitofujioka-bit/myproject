{
  "name": "dailyapps-installer",
  "version": "1.0.0",
  "description": "壱師アプリ iPhone / Apple Watch 再インストール用ツール",
  "main": "src/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:zip": "electron-builder --mac zip"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "jp.myproject.dailyapps-watch-installer",
    "productName": "壱師アプリ再インストール",
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "public/icon.png"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "public/**/*",
      "package.json"
    ]
  }
}
