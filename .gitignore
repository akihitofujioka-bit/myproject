# Node（mobile/ のビルドと apps/tests の Playwright）
node_modules/
*.log
.DS_Store
*.swp

# Python（gikai_editor）
__pycache__/
*.pyc

# 日報ツール（tools/nippo）の OCR 補助プログラム（swiftc で自動生成）
tools/nippo/.build/

# 配布用に作る zip（中身は同じリポジトリのソースから作り直せる）
tools/*.zip

# 配布用 zip に同梱する Windows 用の部品（1 個 数MB のバイナリ）。
# git には入れず、ネットにつながるパソコンで pip download して作る。
# 作り方は各ツールの README「いちばん簡単な入れ方」を見ること。
tools/*/wheels/

# 議会だより 差し込みツール（tools/gikai_template）の様式と設定。
# 様式は前年の議会だより（人の名前が入る）なので、リポジトリに入れない
tools/gikai_template/様式/
tools/gikai_template/設定.json

# 生成された報告書・逐語録は業務情報を含むため git 管理対象外。
# ディレクトリ自体は残したいので .gitkeep だけ通す。
reports/daily/
reports/weekly/
reports/verbatim/
!reports/**/.gitkeep

# 逐語録の作業ファイル（get_transcript の生の応答）
.work/
